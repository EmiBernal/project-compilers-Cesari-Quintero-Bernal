int signo(int x) {
    if (x > 0) {
        return 1;
    } else {
        if (x < 0) {
            return -1;
        } else {
            return 0;
        }
    }
}

int primero(int x) {
    while (x > 0) {
        return x;
    }
    return 0;
}

int bloque(int x) {
    {
        return x + 1;
    }
}

void nada() {
    return;
}

void main() {
    int a;
    a = signo(3) + primero(2) + bloque(1);
    nada();
    return;
}
