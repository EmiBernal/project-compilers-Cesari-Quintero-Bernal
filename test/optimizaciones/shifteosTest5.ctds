extern void printInt(int x);

int main() {
    int i, j, acc, x;
    i = 0;
    acc = 0;
    x = 1000;
    while (i < 10000) {
        j = 0;
        while (j < 10000) {
            acc = acc + (x * 2) + (x * 4) + (x * 8) + (x * 16);
            acc = acc + (x / 2) + (x / 4) + (x / 8) + (x / 16);
            x = x - 150;
            j = j + 1;
        }
        i = i + 1;
    }
    printInt(acc);
    printInt(x);
    return 0;
}