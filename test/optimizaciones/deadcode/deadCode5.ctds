extern void printInt(int x);
extern int getInt();

int signo(int n) {
    if (n > 0) {
        return 1;
    } else {
        if (n < 0) {
            return -1;
        }
    }
    return 0;
}

int main() {
    int i, acc;
    i = 0;
    acc = 0;
    while (i < 10) {
        if (i % 2 == 0) {
            acc = acc + i;
        } else {
            acc = acc - 1;
        }
        i = i + 1;
    }
    printInt(acc);
    printInt(signo(7));
    printInt(signo(-7));
    printInt(signo(0));
    return 0;
}
