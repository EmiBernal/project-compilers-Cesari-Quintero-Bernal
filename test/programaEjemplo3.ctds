int inc(int x) {
    return x + 1;
}

void main() {
    int y;
    int resultado;
    resultado = 0;
    y = 4;
    if (y == 1) {
        resultado = 1;
        return;
    } else {
        if(y == 2){
            resultado = 1;
            return;
        } else {
        resultado = inc(y);    
        return;
        }
    }
}