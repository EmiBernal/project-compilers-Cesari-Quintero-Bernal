// Nueve parametros: 6 en registros y 3 en la pila (con 8 bytes de relleno). Resultado esperado: 29 (285 mod 256)
int f(int a, int b, int c, int d, int e, int g, int h, int i, int j) {
    return a + 2*b + 3*c + 4*d + 5*e + 6*g + 7*h + 8*i + 9*j;
}

int main() {
    return f(1, 2, 3, 4, 5, 6, 7, 8, 9);
}
